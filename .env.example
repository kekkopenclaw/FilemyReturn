# DocuArchive local development — copy to .env and fill in REAL values.
#   cp .env.example .env
# NEVER commit .env. Every value below is a placeholder, not a real secret.
# docker compose refuses to start until the required values are set.

# API JWT signing key — at least 32 characters, random. Required.
JWT_KEY=change-me-to-a-random-string-of-at-least-32-characters

# Seed admin password — at least 12 characters. Required.
# (In Development the API generates a random one if ADMIN_PASSWORD is unset,
# but set it here so you know the login: admin@docuarchive.local.)
ADMIN_PASSWORD=change-me-to-a-password-of-at-least-12-characters

# Postgres password for the local db service — random. Only needed when
# running with the postgres profile (`docker compose --profile postgres up`);
# the default SQLite run never starts the db container and never reads it.
POSTGRES_PASSWORD=change-me-to-a-random-postgres-password

# Optional overrides (defaults shown):
# DATABASE_PROVIDER=Sqlite
# CONNECTION_STRING=Data Source=/app/data/docuarchive.db
# Postgres example (with --profile postgres; password must match POSTGRES_PASSWORD):
# DATABASE_PROVIDER=Postgres
# CONNECTION_STRING=Host=db;Database=docuarchive;Username=docuarchive;Password=change-me-to-a-random-postgres-password
